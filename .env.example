# ── YouTube Data API v3 ────────────────────────────────────────────────────────
# Get a key at https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=YOUR_KEY_HERE

# ISO 3166-1 alpha-2 country code for trending results
YOUTUBE_REGION_CODE=US

# ── Segmentation backend ───────────────────────────────────────────────────────
# 'mediapipe' (CPU, no extra setup) or 'sam2' (GPU, needs checkpoint)
SEGMENTATION_BACKEND=mediapipe

# SAM 2 checkpoint — only needed if SEGMENTATION_BACKEND=sam2
# Download from https://github.com/facebookresearch/segment-anything-2#model-description
SAM2_CHECKPOINT=models/sam2_hiera_large.pt
SAM2_CONFIG=sam2_hiera_l.yaml

# ── Face compositing ───────────────────────────────────────────────────────────
# 'alpha_blend' (fast, no GPU) or 'insightface' (realistic face swap, needs GPU)
COMPOSITING_MODE=alpha_blend

# InsightFace model pack: buffalo_l (best quality) or buffalo_sc (lighter)
INSIGHTFACE_MODEL_PACK=buffalo_l

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
